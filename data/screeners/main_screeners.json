                150
            ]
        },
        "query_as_code": "(Query()\n .select(\n     'base_currency_logoid',\n     'currency_logoid',\n     'name',\n     'close',\n     'change',\n     'change_abs',\n     'bid',\n     'ask',\n     'high',\n     'low',\n     'Recommend.All',\n     'description',\n     'type',\n     'subtype',\n     'update_mode',\n     'pricescale',\n     'minmov',\n     'fractional',\n     'minmove2',\n )\n .where(col('sector').isin(['Major', 'Minor']))\n .order_by('name', ascending=True)\n .limit(150)\n .set_markets('forex')\n .set_property('symbols', {'query': {'types': ['forex']}, 'tickers': []}))"
